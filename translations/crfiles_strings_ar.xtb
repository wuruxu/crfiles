  <translation id="2354633381447034603">تتجاوز العملية الحد المدعوم: 2 غيغابايت لكل ملف، أو 100,000 عنصر، أو الحد الأقصى لطول المسار.</translation>
  <translation id="2752550405647936088">تعذّر حفظ الملف. تحقق من المساحة المتاحة وأذونات المجلد.</translation>
  <translation id="9040466902278940720">تعذّر الوصول إلى هذه المشاركة. تحقق من العنوان والأذونات واتصال الشبكة.</translation>
  <translation id="2212458631965189031">توقفت عملية الشبكة أو انتهت مهلتها. أعد الاتصال للمحاولة مجددًا.</translation>
  <translation id="6961609168703054974">جارٍ البحث عن خوادم SMB…</translation>
  <translation id="3498640952286382790">لم يتم العثور على خوادم SMB. يمكنك إدخال عنوان خادم للاتصال.</translation>
  <translation id="6752580555559785613">حفظ نسخة…</translation>
  <translation id="8616445249860160797">يتم عرض أول 1,000 عنصر.</translation>
  <translation id="2734620146220224770">الوصول للقراءة فقط. تبقى التغييرات على النسخ المنزّلة على هذا الجهاز.</translation>
  <translation id="6738867403308150051">جارٍ التنزيل…</translation>
  <translation id="5207488845892971913">تحميل إلى الخادم…</translation>
  <translation id="3308777219472691043">جارٍ التحميل إلى الخادم…</translation>
  <translation id="7147874188380926791">يدعم هذا الإصدار تحميل ملفات يصل حجم كل منها إلى 2 غيغابايت إلى الخادم.</translation>
  <translation id="8261506727792406068">حذف</translation>
  <translation id="1648253991335349730">هل تريد حذف العناصر المحددة وجميع محتويات المجلدات نهائيًا من الخادم؟ لا يمكن التراجع عن هذا الإجراء.</translation>
  <translation id="8857004281969531494">تعذر إكمال العملية. تحقق من الأذونات وأسماء الملفات واتصال الشبكة.</translation>
  <translation id="1998188314290884673">يوجد عنصر بهذا الاسم بالفعل. اختر اسمًا آخر.</translation>
  <translation id="664120849997175359">تم فتح نسخة محلية. لن يتم تحميل التغييرات إلى الخادم تلقائيًا.</translation>
  <translation id="1742469581923031760">جارٍ الاتصال…</translation>
  <translation id="9125707676157256467">جارٍ التحقق من إذن الكتابة…</translation>
  <translation id="2837767947390987003">لا يسمح هذا المجلد بالكتابة.</translation>
  <translation id="908462521885202173">تعذّر تفعيل المشاركة. حدّث الصفحة للمحاولة مجددًا.</translation>
  <translation id="2488698877694032221">تعذّر حفظ الملف المستلم في مجلد الشبكة.</translation>
  <translation id="1162380600466275954">تم الاحتفاظ بالملفات المستلمة محليًا:</translation>
</translationbundle>