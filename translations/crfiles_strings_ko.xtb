  <translation id="4513044611477939680">Quick Share</translation>
  <translation id="5143492197038582676">같은 네트워크를 사용하세요. Android 기기가 표시되지 않으면 해당 기기에서 Quick Share 수신 화면을 여세요.</translation>
    <translation id="6139027968936271621">파일을 보냈습니다. 기기에서 수신을 확인하지 않았습니다. 기기에서 받은 파일을 확인하세요.</translation>
  <translation id="4545384009119964161">전송이 거부되었습니다.</translation>
  <translation id="2300855866637771705">전송 시간이 초과되었습니다. 연결을 확인하고 다시 시도하세요.</translation>
  <translation id="7295294312375734147">주변 Quick Share 기기</translation>
  <translation id="5026581245371276479">블루투스로만 발견</translation>
  <translation id="7108699793566969157">블루투스로 발견했습니다. 파일을 보내려면 같은 네트워크에 연결하세요.</translation>
  <translation id="5835513660254436267">블루투스로 주변 Quick Share 기기를 검색하고 있습니다.</translation>
  <translation id="8952915576472102937">블루투스 검색을 사용할 수 없습니다. 네트워크에 연결하면 LAN 검색은 계속 사용할 수 있습니다.</translation>
<translation id="2506898760328847284">Quick Share 사용</translation>
<translation id="3216892343488235647">crFiles가 실행 중일 때 같은 네트워크의 주변 기기에서 파일을 받습니다. 전송을 수락하기 전에 매번 코드를 확인하세요.</translation>
<translation id="6232661316106726701">Quick Share가 꺼져 있습니다. 설정에서 켜세요.</translation>
  <translation id="4749345777488346326">알 수 없는 기기</translation>
  <translation id="7391718882028191058">휴대전화</translation>
  <translation id="6449318474603509815">태블릿</translation>
  <translation id="1578438228385927073">노트북</translation>
  <translation id="4630046943484058302">자동차</translation>
  <translation id="8312954834646881944">폴더블 기기</translation>
  <translation id="5513652672301064857">XR 기기</translation>
  <translation id="2152996395357506695">기기에 연결할 수 없습니다.</translation>
  <translation id="8612942777700571324">연결이 끊어졌습니다.</translation>
  <translation id="9182669502444641921">저장 공간을 사용할 수 없거나 가득 찼습니다.</translation>
  <translation id="7155839381404179478">원본 파일을 읽을 수 없습니다.</translation>
  <translation id="4828394398898539554">지원되지 않는 공유 요청입니다.</translation>
  <translation id="6753404677856193000">기기 간 공유 프로토콜을 완료할 수 없습니다.</translation>
  <translation id="3140354002705176144">진단 정보 복사</translation>
  <translation id="2538229999269666773">파일</translation>
  <translation id="6810075817102686774">전송한 파일</translation>
  <translation id="7962960561507616835">전송 속도</translation>
  <translation id="4816292591240970283">남은 시간(분:초)</translation>
<translation id="1431933172646212969">폴더 구조가 유지됩니다. 빈 폴더는 건너뜁니다. 폴더 안의 파일을 포함하여 한 번에 최대 1024개 파일을 전송할 수 있습니다. 수신 기기의 폴더 처리 방식은 다를 수 있습니다.</translation>
  <translation id="1722875882298721247">이 기기로 공유</translation>
  <translation id="6677927904722923469">코드 비교</translation>
  <translation id="5978566236534048645">상대 기기에서 수락하기를 기다리는 중</translation>
  <translation id="6964235745882631674">텍스트 또는 링크</translation>
  <translation id="8551928890709982721">수락하면 받은 텍스트 또는 링크가 클립보드에 복사됩니다.</translation>
  <translation id="2214850006092753179">클립보드에 복사됨</translation>
  <translation id="5125731858634756748">네트워크 연결 복원 중…</translation>
  <translation id="3851611281675392532">네트워크 정리가 완료되지 않았습니다. Wi-Fi 연결을 확인하세요.</translation>
  <translation id="6873287799323878567">Wi-Fi를 사용할 수 없습니다. Bluetooth로 보내려면 파일 수를 줄이거나 더 작은 파일을 선택하세요.</translation>
  <translation id="1974060860693918893">고급</translation>
  <translation id="593016400173783655">Wi-Fi Direct 사용</translation>
  <translation id="7160542542766167615">Wi-Fi Direct 어댑터</translation>
  <translation id="604124094241169006">자동 선택</translation>
  <translation id="777703557475678071">Direct 전송에 사용 가능한 Wi-Fi 어댑터를 사용합니다. 기존 연결을 유지하기 위해 핫스팟으로 사용 중인 어댑터는 제외합니다. 현재 네트워크를 통한 전송은 계속 사용할 수 있습니다.</translation>
  <translation id="1898440255434610465">이번 실행에서는 명령줄 옵션이 해당 설정보다 우선합니다.</translation>
  <translation id="6013061833211324565">핫스팟 사용 중 — Direct 사용 불가</translation>
  <translation id="4989542687859782284">사용 불가</translation>
  <translation id="8688672835843460752">사용 가능</translation>
  <translation id="795506937432030833">Wi-Fi 연결됨</translation>
  <translation id="6382488405705947032">연결된 세그먼트</translation>
  <translation id="8493952405713493204">분할 창 선택 스타일</translation>
  <translation id="4858256948792627109">상단 표시와 은은한 테두리</translation>
  <translation id="6105745639559695088">사이드바 표시 전환</translation>
  <translation id="3273908632551982506">계산 중…</translation>
  <translation id="3737183100366887005">크기(최소)</translation>
  <translation id="5462178630465079387">일부 항목을 읽을 수 없거나 건너뛰었습니다. 심볼릭 링크는 따라가지 않습니다.</translation>
  <translation id="5438994243607599033">흐르는 빛 테두리</translation>
  <translation id="1317822567862518612">모서리 스캔</translation>
  <translation id="1774246671250453305">태그</translation>
  <translation id="5101353843330051800">파일과 폴더에 재사용할 태그를 만듭니다.</translation>
  <translation id="3215146029379093621">추가하거나 제거할 태그를 선택하세요. 경로당 최대 6개입니다. 변경하지 않은 혼합 태그는 유지됩니다.</translation>
  <translation id="8752025040481372078">태그 이름</translation>
  <translation id="4253941650608103900">태그 만들기</translation>
  <translation id="2229162813566390161">태그 적용</translation>
  <translation id="1688748849251095774">태그 편집</translation>
  <translation id="992283138707894632">선택한 항목 중 일부</translation>
  <translation id="2204473532529500944">태그가 없습니다. 태그를 만들어 시작하세요.</translation>
  <translation id="8136517861983351086">제어 문자 없이 1~40자를 입력하세요.</translation>
  <translation id="469386564380447216">경로당 태그는 최대 6개입니다. 변경 사항을 저장하지 않았습니다.</translation>
  <translation id="4783446177251788849">일부 경로를 사용할 수 없습니다.</translation>
  <translation id="9047434598939464995">블록 면적은 항목 수를 나타냅니다. 빈 태그는 작은 블록으로 표시됩니다. 크기는 폴더 내용을 포함하며 중첩된 경로를 중복 계산하지 않습니다.</translation>
<translation id="7173920236757060434">파일을 수신했지만 태그를 저장하지 못했습니다.</translation>
  <translation id="8563932996510222464">태그 추가</translation>
  <translation id="787426481015837208">태그 삭제</translation>
  <translation id="3660848480734478600">태그를 삭제하지 못했습니다.</translation>
  <translation id="5384113860665892500">아래 태그를 삭제하고 연결된 모든 파일과 폴더에서 해당 태그를 제거하시겠습니까? 파일과 폴더 자체는 유지됩니다.</translation>
  <translation id="4233010476457917696">사이드바 표시</translation>
  <translation id="2613033293035359003">사이드바 숨기기</translation>
  <translation id="7998918019931843664">닫은 탭 다시 열기</translation>
  <translation id="5078638979202084724">모든 탭 북마크</translation>
  <translation id="3541874791069107603">다시 연결하고 재시도</translation>
  <translation id="8385154793237841987">이 기기의 다른 Bluetooth 서비스 연결이 잠시 끊어집니다.</translation>
  <translation id="8779418991368148028">Bluetooth에 다시 연결하는 중…</translation>
  <translation id="2503209953868057834">주변 기기를 검색할 수 없습니다. 네트워크를 확인하고 시스템 설정 &gt; 개인정보 보호 및 보안 &gt; 로컬 네트워크에서 crFiles의 접근을 허용하세요. 이미 허용된 경우 접근을 껐다가 다시 켜세요. 자동으로 다시 시도하고 있습니다.</translation>
  <translation id="7031882061095297553">동기화 대상</translation>
  <translation id="6917611495261629542">새 동기화를 시작하려면 파일 또는 폴더 하나를 선택하세요.</translation>
  <translation id="9097448805928983789">동기화 관계</translation>
  <translation id="9130234759791309317">동기화를 지원하는 기기가 없습니다. 두 기기에서 근처 공유를 켜세요.</translation>
  <translation id="1613657715385222389">아직 동기화 관계가 없습니다.</translation>
  <translation id="2170145650202433581">다른 기기를 기다리는 중</translation>
  <translation id="5829649908290113115">동기화 중…</translation>
  <translation id="659339563617986839">최신 상태</translation>
  <translation id="5895244416504545165">동기화가 중단되었습니다. 자동으로 다시 시도합니다. 연결, 폴더 접근 권한 및 여유 공간을 확인하세요.</translation>
  <translation id="5119780910075847424">동기화 일시중지됨</translation>
  <translation id="6738366024175938707">동기화 해제</translation>
  <translation id="6335248546481182258">복구 파일</translation>
  <translation id="6956049626921760252">동기화 데이터베이스를 열거나 저장할 수 없습니다. 다른 crFiles 인스턴스에서 사용 중일 수 있습니다.</translation>
  <translation id="6663644605798061183">이 위치를 동기화할 수 없습니다. 폴더 접근 권한, 이름 및 기존 동기화 관계를 확인하세요.</translation>
  <translation id="6371951046798553292">복구 중 파일이 변경되었습니다. 원본과 임시 파일은 보존되었습니다. 다시 시작하기 전에 복구 폴더를 확인하세요.</translation>
  <translation id="9086302186042011942">동기화 중</translation>
  <translation id="4467043784868232357"><ph name="DEVICE"/>(으)로 동기화</translation>
  <translation id="8798449543960971550">읽기</translation>
  <translation id="1236731661735898386">쓰기</translation>
  <translation id="5610152171700512965">시작: <ph name="STARTED"/> · 최근 동기화: <ph name="SYNCED"/></translation>
  <translation id="2123074103454259350">기록 없음</translation>
  <translation id="5083932160057998629">동기화 권한 대기 중</translation>
  <translation id="4069953589247346347">원격 변경 사항 받기</translation>
  <translation id="522734733030994012"><ph name="DEVICE"/>에서 관리</translation>
  <translation id="3528789313631430010">동기화를 만든 기기에서 수신 기기로 변경 사항을 보내도록 허용합니다.</translation>
  <translation id="3026848479191650761">수신 기기에서 동기화를 만든 기기로 변경 사항을 다시 보내도록 허용합니다.</translation>
  <translation id="752612961231969308">이 폴더의 지속적인 동기화를 허용할까요? 동기화를 만든 기기에서 동기화 권한을 관리합니다. 동기화 중에서 이 관계를 일시중지하거나 삭제할 수 있습니다. 교체되거나 삭제된 파일은 복구 폴더에 보관됩니다.</translation>
  <translation id="369053807563392520">이 파일 또는 폴더를 동기화할 기기를 선택하세요.</translation>
  <translation id="6406506848690869874">동기화</translation>
  <translation id="4635264759968989553">이 위치가 기존 동기화와 겹칩니다. 기존 동기화 관계를 확인하세요.</translation>
  <translation id="8717853395357624361">동기화 폴더를 준비할 수 없습니다. 폴더 접근 권한, 여유 공간, 다른 앱의 사용 여부를 확인하세요.</translation>
  <translation id="112353091401681759">현재 이 기기를 동기화에 사용할 수 없습니다. 다시 표시되면 선택하세요.</translation>
  <translation id="9024022335183653196">동기화 요청을 시작할 수 없습니다. 기존 동기화 관계를 확인한 후 다시 시도하세요.</translation>
  <translation id="5036404633067063740">동기화 관계 또는 대기 중인 요청의 한도에 도달했습니다.</translation>
  <translation id="1139054157857398343">경로를 왼쪽으로 스크롤</translation>
  <translation id="9082767689988059179">경로를 오른쪽으로 스크롤</translation>
  <translation id="3195890836285742116">이미지 미리보기</translation>
  <translation id="8343272671728642074">이미지 불러오는 중…</translation>
  <translation id="7941243322888784931">이전 이미지</translation>
  <translation id="6165094457612892917">다음 이미지</translation>
  <translation id="8903921497873541725">확대</translation>
  <translation id="5975083100439434680">축소</translation>
  <translation id="8003143398148180105">창에 맞추기</translation>
  <translation id="529022811275906337">시스템 앱에서 열기</translation>
  <translation id="605298658602194245">미리보기 화질입니다. 원본 해상도로 보려면 시스템 앱에서 여세요.</translation>
<translation id="1810645640436160198">Quick Share Bluetooth 서비스가 이미 사용 중입니다.</translation>
  <translation id="7982789257301363584">네트워크</translation>
  <translation id="405702086148562568">서버 또는 smb://서버/공유</translation>
  <translation id="5308380583665731573">연결</translation>
  <translation id="462170677807214460">사용자 이름(비워 두면 게스트)</translation>
  <translation id="6657585470893396449">비밀번호</translation>
  <translation id="2869792175039996202">도메인(선택 사항)</translation>
  <translation id="7442543311355254701">로그인하지 못했습니다. 사용자 이름, 비밀번호 및 도메인을 확인하세요.</translation>
  <translation id="3807498914503279405">서버 주소 또는 smb://서버/공유를 입력하세요.</translation>
  <translation id="2354633381447034603">작업이 지원 한도를 초과합니다. 파일당 2 GB, 항목 100,000개 또는 최대 경로 길이가 한도입니다.</translation>
  <translation id="2752550405647936088">파일을 저장하지 못했습니다. 여유 공간과 폴더 권한을 확인하세요.</translation>
  <translation id="9040466902278940720">공유에 접근하지 못했습니다. 주소, 권한 및 네트워크 연결을 확인하세요.</translation>
  <translation id="2212458631965189031">네트워크 프로세스가 중지되었거나 시간이 초과되었습니다. 다시 연결하세요.</translation>
  <translation id="6961609168703054974">SMB 서버 검색 중…</translation>
  <translation id="3498640952286382790">SMB 서버를 찾지 못했습니다. 서버 주소를 입력하여 연결할 수 있습니다.</translation>
  <translation id="6752580555559785613">사본 저장…</translation>
  <translation id="8616445249860160797">처음 1,000개 항목을 표시합니다.</translation>
  <translation id="2734620146220224770">읽기 전용입니다. 다운로드한 사본의 변경 사항은 이 기기에만 저장됩니다.</translation>
  <translation id="6738867403308150051">다운로드 중…</translation>
  <translation id="5207488845892971913">업로드…</translation>
  <translation id="3308777219472691043">업로드 중…</translation>
  <translation id="7147874188380926791">이 버전에서는 파일당 최대 2 GB까지 업로드할 수 있습니다.</translation>
  <translation id="8261506727792406068">삭제</translation>
  <translation id="1648253991335349730">선택한 항목과 폴더의 모든 내용을 서버에서 영구적으로 삭제하시겠습니까? 이 작업은 되돌릴 수 없습니다.</translation>
  <translation id="8857004281969531494">작업을 완료할 수 없습니다. 권한, 파일 이름 및 네트워크 연결을 확인하세요.</translation>
  <translation id="1998188314290884673">같은 이름의 항목이 이미 있습니다. 다른 이름을 선택하세요.</translation>
  <translation id="664120849997175359">로컬 복사본을 열었습니다. 변경 사항은 자동으로 업로드되지 않습니다.</translation>
  <translation id="1742469581923031760">연결 중…</translation>
  <translation id="9125707676157256467">쓰기 권한 확인 중…</translation>
  <translation id="2837767947390987003">이 폴더에는 쓸 수 없습니다.</translation>
  <translation id="908462521885202173">공유를 활성화하지 못했습니다. 새로고침한 후 다시 시도하세요.</translation>
  <translation id="2488698877694032221">받은 파일을 네트워크 폴더에 저장하지 못했습니다.</translation>
  <translation id="1162380600466275954">받은 파일이 로컬에 보관되어 있습니다:</translation>
</translationbundle>
