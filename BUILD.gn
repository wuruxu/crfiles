mojom("crfiles_archive_mojom") {
  sources = [ "crfiles_archive.mojom" ]
  public_deps = [ "//mojo/public/mojom/base" ]
}

mojom("crfiles_search_mojom") {
  sources = [ "crfiles_search.mojom" ]
}

mojom("crfiles_video_thumbnail_mojom") {
  sources = [ "crfiles_video_thumbnail.mojom" ]
  public_deps = [ "//mojo/public/mojom/base" ]
}

action("crfiles_buildtime") {
  script = "tools/generate_buildtime.py"
  inputs = crfiles_sources + [
             "crfiles_archive.mojom",
             "crfiles_search.mojom",
             "crfiles_video_thumbnail.mojom",
             "VERSION",
             "crfiles_strings.grd",
             "BUILD.gn",
             "crfiles_windows.cc",
             "crfiles_windows.h",
             "crfiles_exe.rc",
             "sharing/nearby_files_win.cc",
           ]
  outputs = [ "$target_gen_dir/crfiles_buildtime.h" ]
  args = [
    "--output",
    rebase_path(outputs[0], root_build_dir),
  ]
}

executable("crFiles") {
  sources = crfiles_sources
  if (crfiles_thinlto_optimize_max && (is_linux || is_win || is_mac)) {
    # Apply link-time optimization to the standalone application, as Chromium
    # does for its main executable. The config is inactive without ThinLTO.
    configs -= [ "//build/config/compiler:thinlto_optimize_default" ]
    configs += [ "//build/config/compiler:thinlto_optimize_max" ]
  }
  if (is_mac) {
    sources += [
      "crfiles_file_access_mac.mm",
      "crfiles_heic_thumbnail_mac.mm",
      "crfiles_mac.h",
      "crfiles_mac.mm",
      "crfiles_tray_mac.mm",
    ]
    frameworks = [
      "AppKit.framework",
      "ApplicationServices.framework",
      "AVFoundation.framework",
      "CoreMedia.framework",
      "ImageIO.framework",
      "Security.framework",
    ]
  }
  if (!is_mac) {
    data = [ "third_party/libheif/COPYING" ]
  }
  include_dirs = [ "//third_party/pdfium" ]
  if (enable_libcr_shared) {
    sources += [
      "$root_gen_dir/chrome/app/vector_icons/vector_icons.cc",
      "$root_gen_dir/chrome/app/vector_icons/vector_icons.h",
    ]
    deps = [
      ":crfiles_buildtime",
      ":crfiles_strings",
      ":crfiles_version",
      "//chrome/app/vector_icons:crfiles_icon_sources",
      "//libcr:engine",
    ]

    # Keep application IPC in the EXE. Depend only on generated headers/actions;
    # the regular mojom implementation targets also pull static engine deps.
    foreach(name,
            [
              "crfiles_archive",
              "crfiles_search",
              "crfiles_video_thumbnail",
            ]) {
      deps += [ ":${name}_mojom_headers" ]
      sources += [
        "$target_gen_dir/${name}.mojom-shared.cc",
        "$target_gen_dir/${name}.mojom.cc",
      ]
    }
    no_default_deps = true
    configs += [ "//build/config/gcc:rpath_for_built_shared_libraries" ]
    ldflags = [
      "-Wl,-z,defs",
      "-Wl,--no-allow-shlib-undefined",
    ]
  } else {
    deps = [
      ":crfiles_archive_mojom",
      ":crfiles_buildtime",
      ":crfiles_search_mojom",
      ":crfiles_strings",
      ":crfiles_version",
      ":crfiles_video_thumbnail_mojom",
      "//base",
      "//base:i18n",
      "//base/version_info",
      "//cc/paint",
      "//chrome/app/vector_icons",
      "//components/discardable_memory/service",
      "//components/vector_icons",
      "//crypto",
      "//libcr",
      "//libcr:viz",
      "//media",
      "//mojo/core/embedder",
      "//mojo/public/cpp/bindings",
      "//mojo/public/cpp/platform",
      "//mojo/public/cpp/system",
      "//net",
      "//net/traffic_annotation",
      "//skia",
      "//third_party/boringssl",
      "//third_party/lzma_sdk",
      "//third_party/lzma_sdk:lzma_sdk_xz",
      "//third_party/lzma_sdk/google:seven_zip_reader",
      "//third_party/pdfium",
      "//third_party/sqlite",
      "//third_party/unrar",
      "//third_party/zlib",
      "//third_party/zlib/google:zip",
      "//ui/accessibility",
      "//ui/base",
      "//ui/base/ime/init",
      "//ui/color",
      "//ui/compositor",
      "//ui/display",
      "//ui/events",
      "//ui/gfx",
      "//ui/gfx/codec",
      "//ui/gl",
      "//ui/gl/init",
      "//ui/menus",
      "//ui/native_theme",
      "//ui/shell_dialogs",
      "//ui/views",
      "//url",
    ]
    if (media_use_ffmpeg) {
      deps += [
        "//third_party/dav1d",
        "//third_party/ffmpeg",
        "//third_party/ffmpeg:ffmpeg_features",
      ]
    }
  }
  if (is_mac) {
    deps += [ "//components/remote_cocoa/common:mojo" ]
  }
  if (is_linux || is_win || is_mac) {
    sources += [ "sharing/quick_share_adapter.cc", "sharing/quick_share_adapter.h" ]
    deps += [ "//crQuickShare:protocol" ]
  }
  if (is_linux || is_win) {
    deps += [ "//crQuickShare:ble" ]
    if (!enable_libcr_shared) {
      deps += [ "//device/bluetooth" ]
    }
    configs += [ ":context_gio" ]
    if (!enable_libcr_shared) {
      deps += [ "//third_party/fontconfig" ]
    }
  }
  data_deps = [
    ":app_icon",
    ":crfiles_resources_200_percent_pak",
    ":crfiles_resources_pak",
    ":file_icons",
  ]
  foreach(locale, crfiles_locales) {
    data_deps += [ ":crfiles_resources_${locale}_pak" ]
  }
  if (use_aura && !enable_libcr_shared) {
    deps += [
      "//ui/aura",
      "//ui/wm",
    ]
  }
  if (use_ozone && !enable_libcr_shared) {
    deps += [ "//ui/ozone" ]
  }
  if (is_linux && !enable_libcr_shared) {
    deps += [
      "//ui/linux:display_server_utils",
      "//ui/linux:linux_ui_factory",
    ]
  }
  if (is_win) {
    sources += [
      "crfiles_exe.rc",
      "crfiles_tray_win.cc",
      "crfiles_windows.cc",
      "crfiles_windows.h",
      "resources/win/crfiles_resource.h",
      "sharing/nearby_files_win.cc",
    ]
    inputs = [ "resources/win/crfiles_app_icon.ico" ]
    libs = [
      "iphlpapi.lib",
      "ws2_32.lib",
      "shell32.lib",
      "shlwapi.lib",
      "ole32.lib",
      "uuid.lib",
    ]
    configs += [ "//build/config/win:windowed" ]
    configs -= [ "//build/config/win:console" ]
  }
}
