import("//build/config/libcr.gni")
import("//build/config/ui.gni")
import("//build/util/process_version.gni")
import("//libcr/locales.gni")
import("//media/media_options.gni")
import("//mojo/public/tools/bindings/mojom.gni")
import("//testing/test.gni")
import("//tools/grit/grit_rule.gni")
import("//tools/grit/repack.gni")
declare_args() {
  # Linux packaging enables this explicitly; Windows and macOS keep it on.
  crfiles_thinlto_optimize_max = is_win || is_mac
}
if (is_linux) {
  import("//build/config/linux/pkg_config.gni")
  pkg_config("context_gio") {
    packages = [ "gio-unix-2.0" ]
  }
}
crfiles_locales = libcr_supported_locales + [
                    "ja",
                    "ko",
                  ]

test("crfiles_dialog_unittests") {
  sources = [
    "crfiles_dialog.cc",
    "crfiles_dialog.h",
    "crfiles_dialog_unittest.cc",
    "crfiles_unittest_main.cc",
  ]
  deps = [
    "//base",
    "//base/test:test_support",
    "//mojo/core/embedder",
    "//testing/gtest",
    "//ui/resources:ui_test_pak",
    "//ui/views",
    "//ui/views:test_support",
  ]
}

process_version("crfiles_version") {
  process_only = true
  sources = [ "VERSION" ]
  template_file = "crfiles_version.h.version"
  output = "$target_gen_dir/crfiles_version.h"
}

grit("crfiles_strings") {
  source = "crfiles_strings.grd"
  resource_ids = ""
  outputs = [
    "grit/crfiles_strings.h",
    "crfiles_strings_en-US.pak",
  ]

  foreach(locale, crfiles_locales) {
    outputs += [ "crfiles_strings_${locale}.pak" ]
  }
}

repack("crfiles_resources_pak") {
  sources = [
    "$root_gen_dir/crFiles/crfiles_strings_en-US.pak",
    "$root_gen_dir/ui/resources/ui_resources_100_percent.pak",
    "$root_gen_dir/ui/strings/app_locale_settings_en-US.pak",
    "$root_gen_dir/ui/strings/ax_strings_en-US.pak",
    "$root_gen_dir/ui/strings/ui_strings_en-US.pak",
  ]
  output = "$root_out_dir/crfiles_resources.pak"
  deps = [
    ":crfiles_strings",
    "//ui/resources",
    "//ui/strings",
  ]
  if (toolkit_views) {
    sources +=
        [ "$root_gen_dir/ui/views/resources/views_resources_100_percent.pak" ]
    deps += [ "//ui/views/resources" ]
  }
}

foreach(locale, crfiles_locales) {
  repack("crfiles_resources_${locale}_pak") {
    sources = [
      "$root_gen_dir/crFiles/crfiles_strings_${locale}.pak",
      "$root_gen_dir/ui/strings/app_locale_settings_${locale}.pak",
      "$root_gen_dir/ui/strings/ax_strings_${locale}.pak",
      "$root_gen_dir/ui/strings/ui_strings_${locale}.pak",
    ]
    output = "$root_out_dir/crfiles_resources_${locale}.pak"
    deps = [
      ":crfiles_strings",
      "//ui/strings",
    ]
  }
}

repack("crfiles_resources_200_percent_pak") {
  sources = [ "$root_gen_dir/ui/resources/ui_resources_200_percent.pak" ]
  output = "$root_out_dir/crfiles_resources_200_percent.pak"
  deps = [ "//ui/resources" ]
  if (toolkit_views) {
    sources +=
        [ "$root_gen_dir/ui/views/resources/views_resources_200_percent.pak" ]
    deps += [ "//ui/views/resources" ]
  }
}

copy("app_icon") {
  sources = [ "crFiles.svg" ]
  outputs = [ "$root_out_dir/crfiles_resources/{{source_file_part}}" ]
}

copy("file_icons") {
  sources = [
    "resources/file_icons/COPYRIGHT",
    "resources/file_icons/README.md",
    "resources/file_icons/application-x-executable.svg",
    "resources/file_icons/application-x-generic.svg",
    "resources/file_icons/audio-x-generic.svg",
    "resources/file_icons/font-x-generic.svg",
    "resources/file_icons/image-x-generic.svg",
    "resources/file_icons/inode-directory.svg",
    "resources/file_icons/package-x-generic.svg",
    "resources/file_icons/text-html.svg",
    "resources/file_icons/text-x-generic.svg",
    "resources/file_icons/text-x-script.svg",
    "resources/file_icons/video-x-generic.svg",
    "resources/file_icons/x-office-document.svg",
    "resources/file_icons/x-office-presentation.svg",
    "resources/file_icons/x-office-spreadsheet.svg",
  ]
  outputs =
      [ "$root_out_dir/crfiles_resources/file_icons/{{source_file_part}}" ]
}

