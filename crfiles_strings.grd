      <message name="IDS_CRFILES_TAG_DELETE_CONFIRM" desc="Confirmation before deleting tags; selected virtual tag paths are listed below.">Delete the tags listed below and remove them from all associated files and folders? The files and folders themselves will be kept.</message>
      <message name="IDS_CRFILES_SYNC_START" desc="Button that starts or retries sync with the selected device.">Sync</message>
      <message name="IDS_CRFILES_SYNC_TO" desc="Two-way file synchronization interface.">Sync to</message>
      <message name="IDS_CRFILES_SYNC_SELECT_ONE" desc="Two-way file synchronization interface.">Select one file or folder to start a new sync.</message>
      <message name="IDS_CRFILES_SYNC_RELATIONSHIPS" desc="Two-way file synchronization interface.">Sync relationships</message>
      <message name="IDS_CRFILES_SYNC_NO_DEVICES" desc="Two-way file synchronization interface.">No devices supporting sync are available. Enable nearby sharing on both devices.</message>
      <message name="IDS_CRFILES_SYNC_NONE" desc="Two-way file synchronization interface.">No sync relationships yet.</message>
      <message name="IDS_CRFILES_SYNC_WAITING" desc="Two-way file synchronization interface.">Waiting for the other device</message>
      <message name="IDS_CRFILES_SYNC_ACTIVE" desc="Two-way file synchronization interface.">Syncing…</message>
      <message name="IDS_CRFILES_SYNC_CURRENT" desc="Two-way file synchronization interface.">Up to date</message>
      <message name="IDS_CRFILES_SYNC_RETRY" desc="Two-way file synchronization interface.">Sync interrupted. Retrying automatically; check the connection, folder access and available space.</message>
      <message name="IDS_CRFILES_SYNC_PAUSED" desc="Two-way file synchronization interface.">Sync paused</message>
      <message name="IDS_CRFILES_SYNC_PAUSE" desc="Two-way file synchronization interface.">Pause</message>
      <message name="IDS_CRFILES_SYNC_RESUME" desc="Two-way file synchronization interface.">Resume</message>
      <message name="IDS_CRFILES_SYNC_REMOVE" desc="Two-way file synchronization interface.">Remove sync</message>
      <message name="IDS_CRFILES_SYNC_RECOVERY" desc="Two-way file synchronization interface.">Recovery files</message>
      <message name="IDS_CRFILES_SYNC_STORAGE_ERROR" desc="Two-way file synchronization interface.">Cannot open or save the sync database. Another crFiles instance may be using it.</message>
      <message name="IDS_CRFILES_SYNC_SOURCE_ERROR" desc="Two-way file synchronization interface.">Cannot sync this location. Check folder access, names and existing sync relationships.</message>
      <message name="IDS_CRFILES_SYNC_RECOVERY_REQUIRED" desc="Two-way file synchronization interface.">A file changed during recovery. Originals and staged files are preserved. Review the recovery folder before resuming.</message>
      <message name="IDS_CRFILES_SYNCING" desc="Sync device access, permissions and relationship management.">Syncing</message>
      <message name="IDS_CRFILES_SYNC_TO_DEVICE" desc="Sync device access, permissions and relationship management.">Sync to <ph name="DEVICE">$1<ex>Laptop</ex></ph></message>
      <message name="IDS_CRFILES_SYNC_READ" desc="Sync device access, permissions and relationship management.">Read</message>
      <message name="IDS_CRFILES_SYNC_WRITE" desc="Sync device access, permissions and relationship management.">Write</message>
      <message name="IDS_CRFILES_SYNC_TIMES" desc="Sync device access, permissions and relationship management.">Started: <ph name="STARTED">$1<ex>11/3/2026 10:00</ex></ph> · Last synced: <ph name="SYNCED">$2<ex>11/3/2026 10:05</ex></ph></message>
      <message name="IDS_CRFILES_SYNC_NOT_YET" desc="Sync device access, permissions and relationship management.">Not yet</message>
      <message name="IDS_CRFILES_SYNC_NO_PERMISSION" desc="Sync device access, permissions and relationship management.">Waiting for sync permissions</message>
      <message name="IDS_CRFILES_SYNC_UPDATE_FROM_REMOTE" desc="Sync permissions controlled by the device that created the relationship.">Update from remote</message>
      <message name="IDS_CRFILES_SYNC_MANAGED_BY" desc="Sync permissions controlled by the device that created the relationship.">Managed by <ph name="DEVICE">$1<ex>Laptop</ex></ph></message>
      <message name="IDS_CRFILES_SYNC_READ_HINT" desc="Sync permissions controlled by the device that created the relationship.">Allow updates from the creating device to the receiving device.</message>
      <message name="IDS_CRFILES_SYNC_WRITE_HINT" desc="Sync permissions controlled by the device that created the relationship.">Allow updates from the receiving device back to the creating device.</message>
      <message name="IDS_CRFILES_SYNC_CONSENT" desc="Sync permissions controlled by the device that created the relationship.">Allow ongoing sync in this folder? The creating device controls sync permissions. You can pause or remove this relationship in Syncing. Replaced and deleted files are kept in the recovery folder.</message>
      <message name="IDS_CRFILES_SYNC_HINT" desc="Sync permissions controlled by the device that created the relationship.">Choose a device to sync this file or folder.</message>
      <message name="IDS_CRFILES_SYNC_OVERLAP_ERROR" desc="Specific cause of a failure to start or prepare synchronization.">This location overlaps an existing sync. Check existing sync relationships.</message>
      <message name="IDS_CRFILES_SYNC_PREPARE_ERROR" desc="Specific cause of a failure to start or prepare synchronization.">Cannot prepare the sync folder. Check folder access, available space, and whether another app is using it.</message>
      <message name="IDS_CRFILES_SYNC_DEVICE_ERROR" desc="Specific cause of a failure to start or prepare synchronization.">This device is no longer available for sync. Select it again when it appears.</message>
      <message name="IDS_CRFILES_SYNC_REQUEST_ERROR" desc="Specific cause of a failure to start or prepare synchronization.">Could not start this sync request. Check existing sync relationships and try again.</message>
      <message name="IDS_CRFILES_SYNC_LIMIT_ERROR" desc="Specific cause of a failure to start or prepare synchronization.">The sync relationship or pending request limit has been reached.</message>
</messages>
  </release>
</grit>
