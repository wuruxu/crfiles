      <message name="IDS_CRFILES_EXTRACT_TO" desc="Archive extraction menu and progress dialog.">Extract to…</message>
      <message name="IDS_CRFILES_ARCHIVE_PASSWORD" desc="Archive extraction menu and progress dialog.">Password (optional)</message>
      <message name="IDS_CRFILES_EXTRACT_NOTICE" desc="Archive extraction menu and progress dialog.">Existing files and folders will not be overwritten.</message>
      <message name="IDS_CRFILES_EXTRACTING" desc="Archive extraction menu and progress dialog.">Extracting…</message>
      <message name="IDS_CRFILES_EXTRACT_ERROR" desc="Archive extraction menu and progress dialog.">Extraction failed. Check the password, archive format, available space, and conflicting names.</message>
      <message name="IDS_CRFILES_EXTRACT_SUCCESS" desc="Archive extraction menu and progress dialog.">Extraction completed.</message>
      <message name="IDS_CRFILES_HISTORY_CANCELED" desc="Canceled file operation in History.">Canceled</message>
      <message name="IDS_CRFILES_EXTRACT_CONFLICT" desc="Extraction blocked by an existing file or directory. PATH is the full conflicting path.">Already exists: <ph name="PATH">$1<ex>/Downloads/example</ex></ph>. Choose another destination.</message>
      <message name="IDS_CRFILES_ARCHIVE_PASSWORD_REQUIRED" desc="Encrypted archive password prompt.">Enter a valid archive password to continue.</message>
      <message name="IDS_CRFILES_EXTRACT_NAMED" desc="Extract into a directory named after the archive.">Extract to <ph name="NAME">$1<ex>example</ex></ph>/</message>
      <message name="IDS_CRFILES_REPLACE_ALL" desc="Archive conflict confirmation and recovery.">Replace all</message>
      <message name="IDS_CRFILES_REPLACE" desc="Archive conflict confirmation and recovery.">Replace</message>
      <message name="IDS_CRFILES_SKIP" desc="Archive conflict confirmation and recovery.">Skip</message>
      <message name="IDS_CRFILES_EXTRACT_EXISTS" desc="Archive conflict confirmation and recovery.">Already exists: <ph name="PATH">$1<ex>/Downloads/example</ex></ph></message>
      <message name="IDS_CRFILES_EXTRACT_RECOVERY" desc="Archive conflict confirmation and recovery.">Replacement failed. The original entry is preserved in: <ph name="PATH">$1<ex>/Downloads/example</ex></ph></message>
    </messages>
  </release>
</grit>
